<UserControl x:Class="umfg.venda.app.programacao.iii._2026.UserControls.ucListarProdutos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:umfg.venda.app.programacao.iii._2026.UserControls"
             mc:Ignorable="d"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:DesignHeight="720" d:DesignWidth="1080">
    <Grid Background="#ECF0F1">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        
        <!--body - listar os produtos -->
        <Grid Grid.Row="0">
            <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                <ListBox 
                    ItemsSource="{Binding Lista}"
                    SelectedItem="{Binding ProdutoSelecionado}"
                    SelectionMode="Single"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    >

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card
                                Width="250"
                                Margin="10"
                                UniformCornerRadius="12"
                                Background="White">
                                <StackPanel Margin="15">
                                    <Border Width="180"
                                            Height="180"
                                            CornerRadius="8"
                                            Margin="15 0 15 15">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Imagem}" 
                                                        Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>

                                    <TextBlock Text="{Binding Referencia}"
                                               FontSize="14"
                                               Foreground="#757575"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding Descricao}"
                                               FontSize="18"
                                               Foreground="#333333"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0 5 0 10"
                                               Height="50"/>

                                    <StackPanel Orientation="Horizontal" 
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="R$ "
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#2196F3"/>
                                        <TextBlock Text="{Binding Valor}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#2196F3"/>
                                    </StackPanel>
                                </StackPanel>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Grid>
        
        <!--footer - botões -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="0 1 0 0">
            <Grid Margin="20 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center">
                    <Button Content="Adicionar Item"
                            CommandParameter="{Binding}"
                            Command="{Binding AdicionarItem, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#2196F3" BorderBrush="#2196F3" Foreground="White"
                            Height="45" Width="150" FontSize="16" Margin="0 0 15 0"/>

                    <Button Content="Remover Item"
                            CommandParameter="{Binding}"
                            Command="{Binding RemoverItem, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#FF3B30" BorderBrush="#FF3B30" Foreground="White"
                            Height="45" Width="150" FontSize="16" Margin="0 0 15 0"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Subtotal:" FontSize="16" Foreground="#757575" 
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 10 0"/>
                    
                    <TextBlock Text="R$" FontSize="22" Foreground="#333333" 
                               FontWeight="Bold" VerticalAlignment="Center" Margin="0 0 10 0"/>

                    <TextBlock Text="{Binding Pedido.Subtotal}" FontSize="22" Foreground="#333333" 
                               FontWeight="Bold" VerticalAlignment="Center" Margin="0 0 10 0"/>

                    <Button Content="Receber Pedido"
                            CommandParameter="{Binding}"
                            Command="{Binding ReceberPedido, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#00C853" BorderBrush="#00C853" Foreground="White"
                            Height="45" Width="150" FontSize="16" Margin="0 0 15 0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>