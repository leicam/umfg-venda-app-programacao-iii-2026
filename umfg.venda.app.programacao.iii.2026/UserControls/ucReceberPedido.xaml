<UserControl x:Class="umfg.venda.app.programacao.iii._2026.UserControls.ucReceberPedido"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:umfg.venda.app.programacao.iii._2026.UserControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1080">
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Margin="20"
                             MinWidth="100" 
                             MaxWidth="450"
                             MinHeight="100"
                             MaxHeight="450"
                             UniformCornerRadius="12" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Detalhes do Pagamento"
                               FontSize="32"
                               FontWeight="Bold"
                               Margin="25"
                               Foreground="#2c3e50"/>

                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="Forma de Pagamento"
                              FontSize="16"
                              Margin="20">
                        <ComboBoxItem Content="Cartão de Crédito"/>
                        <ComboBoxItem Content="Cartão de Débito"/>
                    </ComboBox>

                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Número do Cartão"
                             Text="{Binding NumeroCartao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16"
                             MaxLength="16"
                             PreviewTextInput="TextBox_PreviewTextInput"
                             Margin="20 0 20 20"/>

                    <Grid Margin="20 0 20 20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Número do CVV"
                                 Text="{Binding CVV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="16"
                                 MaxLength="3"
                                 Height="55"
                                 PreviewTextInput="TextBox_PreviewTextInput"
                                 Margin="0 0 20 20"/>

                        <DatePicker Grid.Column="2"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    materialDesign:HintAssist.Hint="Data de Validade (mm/aa)"
                                    SelectedDate="{Binding DataValidade, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="16"
                                    CalendarOpened="DatePicker_CalendarOpened"
                                    Height="55"
                                    VerticalAlignment="Top"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>
        
        <!--footer - botões -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="0 1 0 0">
            <Grid Margin="20 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="Cancelar"
                            CommandParameter="{Binding}"
                            Command="{Binding CancelarPagamento, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#FF3B30" BorderBrush="#FF3B30" Foreground="White"
                            Height="45" Width="150" FontSize="16" Margin="0 0 15 0"/>
                    
                    <Button Content="Confirmar"
                            CommandParameter="{Binding}"
                            Command="{Binding ConfirmarPagamento, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#00C853" BorderBrush="#00C853" Foreground="White"
                            Height="45" Width="150" FontSize="16" Margin="0 0 15 0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>