<Window x:Class="umfg.venda.app.programacao.iii._2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:umfg.venda.app.programacao.iii._2026"
        mc:Ignorable="d"
        WindowState="Maximized"        
        Height="720" Width="1080">
    <Grid Background="#ECF0F1">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="splTitulo" 
                    Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="25 0 0 0">
            <TextBlock FontSize="28" 
                       FontWeight="SemiBold"
                       FontFamily="Trebuchet MS"
                       Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
        </StackPanel>

        <Button x:Name="btnIniciarPedido"
                Grid.Row="1"
                Width="250"
                Height="250"
                Content="_Iniciar"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"                
                CommandParameter="{Binding}"
                Command="{Binding IniciarPedido, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Background="#2196F3" BorderBrush="#2196F3" Foreground="White"
                FontSize="30"
                FontFamily="Trebuchet MS"/>

        <Frame Grid.Row="1"
               Content="{Binding UserControl}"
               NavigationUIVisibility="Hidden">
        </Frame>
    </Grid>
</Window>